<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Image Search</title>
</head>
<body>
    <h1>Image Search</h1>
    <form method="post">
        <input type="text" name="query" placeholder="Describe what you're looking for" value="<%= query %>" required>
        <button type="submit">Search</button>
    </form>
    <% if (matches.length > 0) { %>
        <h2>Matches</h2>
        <ul>
        <% matches.forEach(function(file){ %>
            <li>
                <img src="/images/<%= file %>" alt="<%= file %>" style="max-width:200px;"><br>
                <%= file %>
            </li>
        <% }); %>
        </ul>
    <% } else if (query) { %>
        <p>No matches found.</p>
    <% } %>
</body>
</html>

